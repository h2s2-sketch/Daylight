# Express server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# AI: mock requires no credentials
AI_MODE=mock
# AI_MODE=api_key
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODE=agent_sdk

# Optional locally, required for the public VPS deployment.
# Set all three together. Never commit real values.
AUTH_USERNAME=
AUTH_PASSWORD=
SESSION_SECRET=

